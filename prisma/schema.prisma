generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plano {
  FREE
  STARTER
  PRO
}

enum StatusAgendamento {
  PENDENTE
  CONFIRMADO
  CANCELADO
  CONCLUIDO
  NO_SHOW
}

enum TipoMensagem {
  CONFIRMACAO_24H
  CONFIRMACAO_2H
  CANCELAMENTO
}

enum StatusMensagem {
  PENDENTE
  ENVIADA
  RESPONDIDA
  ERRO
}

model Tenant {
  id             String   @id @default(uuid())
  clerkOrgId     String   @unique
  nome           String
  whatsappNumber String
  plano          Plano    @default(FREE)
  msgTemplate    String   @default("Oi {nome}! Voce tem {servico} hoje as {horario}. Confirma? Sim / Nao consigo ir")
  ativo          Boolean  @default(true)
  createdAt      DateTime @default(now())

  clientes     Cliente[]
  agendamentos Agendamento[]

  @@index([clerkOrgId])
}

model Cliente {
  id              String   @id @default(uuid())
  tenantId        String
  nome            String
  telefone        String
  servicoFavorito String?
  totalVisitas    Int      @default(0)
  ativo           Boolean  @default(true)
  createdAt       DateTime @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agendamentos Agendamento[]

  @@unique([tenantId, telefone])
  @@index([tenantId])
}

model Agendamento {
  id         String            @id @default(uuid())
  tenantId   String
  clienteId  String
  servico    String
  dataHora   DateTime
  status     StatusAgendamento @default(PENDENTE)
  observacao String?
  createdAt  DateTime          @default(now())

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cliente   Cliente    @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  mensagens Mensagem[]

  @@index([tenantId, dataHora])
}

model Mensagem {
  id              String         @id @default(uuid())
  agendamentoId   String
  tipo            TipoMensagem
  status          StatusMensagem @default(PENDENTE)
  respostaCliente String?
  enviadaEm       DateTime?
  respondidaEm    DateTime?
  createdAt       DateTime       @default(now())

  agendamento Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)

  @@index([agendamentoId])
}
